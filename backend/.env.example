# ============================================================================
# PeoplePay360 Backend Configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ============================================================================

APP_NAME=PeoplePay360
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEBUG=true

# ---- Database ---------------------------------------------------------------
# docker compose maps the pgvector container to host port 5433
DATABASE_URL=postgresql+psycopg://peoplepay:peoplepay@localhost:5433/peoplepay360
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---- Security ---------------------------------------------------------------
# MUST be overridden outside development. The app refuses to boot with the
# default value when ENVIRONMENT=production.
JWT_SECRET=dev-only-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# ---- Company defaults -------------------------------------------------------
COMPANY_NAME=OXP Pvt Ltd
COMPANY_CURRENCY_SYMBOL=Rs.
DEFAULT_TIMEZONE=Asia/Kolkata

# ============================================================================
# AI SUBSYSTEM - the ONLY place the AI runtime is decided
# ============================================================================

# ---- Retrieval: ALWAYS local. No key, no GPU, no network. ----
# fastembed | hash   ("hash" = dependency-free deterministic fallback)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- Generation: pick ONE. groq | gemini | ollama | extractive ----
LLM_PROVIDER=extractive

# Groq (recommended: ~30 RPM free, ~500 tok/s, no credit card)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (backup key - swap LLM_PROVIDER=gemini if Groq throttles)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (only if a GPU machine is available / air-gapped deployment)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ---- Retrieval tuning -------------------------------------------------------
# Below this top cosine score the assistant refuses and escalates to a human.
# CALIBRATED per embedding model, not arbitrary. Re-run
#   python -m scripts.calibrate_threshold
# after changing EMBEDDING_MODEL or materially changing the corpus.
# bge-small-en-v1.5 scores unrelated English prose at ~0.40-0.59 and plausible
# but undocumented questions at ~0.61, so anything lower silently admits nonsense.
RAG_CONFIDENCE_THRESHOLD=0.65
RAG_DEDUP_THRESHOLD=0.90        # above this -> reuse a prior human answer
RAG_TOP_K=3
MAX_OPEN_TICKETS_PER_EMPLOYEE=5

# ---- Email (payslip dispatch). Leave host blank to log instead of send. -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=payroll@oxp.example.com
SMTP_USE_TLS=true
